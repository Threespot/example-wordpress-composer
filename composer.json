        },
        "require": {
          "junaidbhura/composer-wp-pro-plugins": "*"
        }
      }
    },
    {
      "type": "package",
      "package": {
        "name": "junaidbhura/wp-all-export-pro",
        "version": "1.9.15",
        "type": "wordpress-plugin",
        "dist": {
          "type": "zip",
          "url": "https://www.wpallimport.com/"
        },
        "require": {
          "junaidbhura/composer-wp-pro-plugins": "*"
        }
      }
    },
    {
      "type": "package",
      "package": {
        "name": "junaidbhura/wp-all-import-pro",
        "version": "5.0.8",
        "type": "wordpress-plugin",
        "dist": {
          "type": "zip",
          "url": "https://www.wpallimport.com/"
        },
        "require": {
          "junaidbhura/composer-wp-pro-plugins": "*"
        }
      }
    },
    {
      "type": "package",
      "package": {
        "name": "junaidbhura/wpae-acf-add-on",
        "version": "2.0.0",
        "type": "wordpress-plugin",
        "dist": {
          "type": "zip",
          "url": "https://www.wpallimport.com/"
        },
        "require": {
          "junaidbhura/composer-wp-pro-plugins": "*"
        }
      }
    },
    {
      "type": "package",
      "package": {
        "name": "junaidbhura/wpai-acf-add-on",
        "version": "4.0.2",
        "type": "wordpress-plugin",
        "dist": {
          "type": "zip",
          "url": "https://www.wpallimport.com/"
        },
        "require": {
          "junaidbhura/composer-wp-pro-plugins": "*"
        }
      }
    },
    {
      "type": "package",
      "package": {
        "name": "junaidbhura/wpai-user-add-on",
        "version": "1.1.10",
        "type": "wordpress-plugin",
        "dist": {
          "type": "zip",
          "url": "https://www.wpallimport.com/"
        },
        "require": {
          "junaidbhura/composer-wp-pro-plugins": "*"
        }
      }
    }
  ],
  "require": {
    "php": ">=8.3",
    "admin-columns/admin-columns-pro": "^7.0.18",
    "composer/installers": "^2.3.0",
    "cweagans/composer-patches": "^2.0.0",
    "filp/whoops": "^2.14",
    "gravity/gravityforms": "^3.0.2",
    "gravity/gravityformsgoogleanalytics": "^2.4.1",
    "johnbillion/extended-cpts": "^5.0.0",
    "junaidbhura/acf-extended-pro": "*",
    "junaidbhura/wp-all-export-pro": "*",
    "junaidbhura/wp-all-import-pro": "*",
    "junaidbhura/wpae-acf-add-on": "*",
    "junaidbhura/wpai-acf-add-on": "*",
    "junaidbhura/wpai-user-add-on": "*",
    "log1x/navi": "^3.0.2",
    "oscarotero/env": "^2.1",
    "pantheon-systems/pantheon-mu-plugin": "^1.5.6",
    "pantheon-systems/quicksilver-pushback": "^2.0",
    "rhubarbgroup/object-cache-pro": "^1.25.0",
    "roots/acorn": "^6.0",
    "roots/acorn-prettify": "^1.0.1",
    "roots/bedrock-autoloader": "^1.0",
    "roots/bedrock-disallow-indexing": "^2.0",
    "roots/wordpress": "~7.0.3",
    "roots/wp-config": "^1.0.0",
    "threespot/wp-base-config": "^0.2.2",
    "vlucas/phpdotenv": "^5.4",
    "wp-plugin/acf-gravityforms-add-on": "^1.3.10",
    "wp-plugin/admin-menu-editor": "^1.12.4",
    "wp-plugin/ai": "^1.0.0",
    "wp-plugin/ai-provider-for-anthropic": "^1.0.3",
    "wp-plugin/ai-provider-for-google": "^1.1.0",
    "wp-plugin/ai-provider-for-openai": "^1.0.3",
    "wp-plugin/better-image-sizes": "^3.8.0",
    "wp-plugin/block-manager": "^3.0",
    "wp-plugin/cloudflare": "^4.14",
    "wp-plugin/csv-xml-import-for-acf": "^1.0.8",
    "wp-plugin/disable-embeds": "^1.5",
    "wp-plugin/disable-emojis": "^1.7",
    "wp-plugin/duplicate-post": "^4.5.0",
    "wp-plugin/enable-media-replace": "^4.1.5",
    "wp-plugin/favicon-by-realfavicongenerator": "^1.3.32",
    "wp-plugin/filebird": "^6.3.2",
    "wp-plugin/gravityformscli": "^1.9.0",
    "wp-plugin/pantheon-advanced-page-cache": "^2.0",
    "wp-plugin/pantheon-hud": "^0.4.3",
    "wp-plugin/post-type-switcher": "^4.0.0",
    "wp-plugin/query-monitor": "^4.0.6",
    "wp-plugin/redirection": "^5.5.0",
    "wp-plugin/resize-image-after-upload": "^1.8.6",
    "wp-plugin/safe-svg": "^2.2.5",
    "wp-plugin/simple-custom-post-order": "^2.5.7",
    "wp-plugin/term-management-tools": "^2.0.2",
    "wp-plugin/user-switching": "^1.11.0",
    "wp-plugin/wordpress-seo": "^28.0.0",
    "wp-plugin/wp-crontrol": "^1.18",
    "wp-plugin/wp-native-php-sessions": "^1.2",
    "wp-plugin/wp-security-audit-log": "^5.5.3",
    "wp-theme/twentytwentyfive": "^1.2",
    "wpengine/advanced-custom-fields-pro": "~6.8.5"
  },
  "require-dev": {
    "brain/monkey": "^2.6",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "pantheon-systems/pantheon-wp-coding-standards": "^3.0",
    "php-stubs/acf-pro-stubs": "^6.0",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.5",
    "roave/security-advisories": "dev-latest",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "threespot/wp-fixtures": "^0.1.8"
  },
  "config": {
    "vendor-dir": "vendor",
    "preferred-install": "dist",
    "optimize-autoloader": true,
    "sort-packages": true,
    "platform": {
      "php": "8.3",
      "ext-redis": "5.3.7"
    },
    "allow-plugins": {
      "composer/installers": true,
      "cweagans/composer-patches": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "johnpbloch/wordpress-core-installer": true,
      "junaidbhura/composer-wp-pro-plugins": true,
      "phpstan/extension-installer": true,
      "roots/wordpress-core-installer": true
    }
  },
  "extra": {
    "enable-patching": true,
    "wordpress-install-dir": "web/wp",
    "build-env": {
      "install-cms": [
        "wp core install --title={site-name} --url={site-url} --admin_user={account-name} --admin_email={account-mail} --admin_password={account-pass}",
        "wp option update permalink_structure '/%postname%/'"
      ]
    },
    "installer-paths": {
      "web/wp-content/plugins/{$name}/": ["type:wordpress-plugin"],
      "web/wp-content/mu-plugins/{$name}/": ["type:wordpress-muplugin"],
      "web/wp-content/themes/{$name}/": ["type:wordpress-theme"],
      "web/private/scripts/quicksilver/{$name}/": ["type:quicksilver-script"]
    },
    "mu-plugin-stubs": {
      "loader.php": "https://raw.githubusercontent.com/pantheon-systems/WordPress/default/wp-content/mu-plugins/loader.php",
      "bedrock-autoloader.php": "https://raw.githubusercontent.com/roots/bedrock/master/web/app/mu-plugins/bedrock-autoloader.php"
    }
  },
  "autoload": {
    "classmap": [
      "scripts/composer/ScriptHandler.php"
    ],
    "psr-4": { "PantheonSystems\\WordHatHelpers\\": "tests/behat/helper_classes/" }
  },
  "autoload-dev": {
    "psr-4": { "Gih\\Tests\\": "tests/" }
  },
  "scripts": {
    "build-assets": [
      "@prepare-for-pantheon",
      "composer install --ignore-platform-req=ext-redis --no-dev --no-ansi --no-interaction --optimize-autoloader --no-progress --prefer-dist"
    ],
    "prepare-for-pantheon": "WordPressProject\\composer\\ScriptHandler::prepareForPantheon",
    "cleanup": [
      "./scripts/composer/cleanup-composer"
    ],
    "post-install-cmd": [
      "@cleanup",
      "WordPressProject\\composer\\ScriptHandler::createRequiredFiles"
    ],
    "post-update-cmd": [
      "@cleanup",
      "WordPressProject\\composer\\ScriptHandler::createRequiredFiles"
    ],
    "post-create-project-cmd": [
      "@cleanup",
      "WordPressProject\\composer\\ScriptHandler::createRequiredFiles"
    ],
    "mu-stubs:update": [
      "WordPressProject\\composer\\ScriptHandler::updateMuPluginStubs"
    ],
    "phpstan": [
      "./vendor/bin/phpstan analyse --memory-limit=1G"
    ],
    "phpcs": [
      "./vendor/bin/phpcs"
    ],
    "phpcbf": [
      "./vendor/bin/phpcbf"
    ],
    "unit-test": [
      "./vendor/bin/phpunit"
    ],
    "lint": "git ls-files -z 'web/wp-content/*.php' ':!:web/wp-content/plugins/*' | xargs -0 -P4 -n1 php -l",
    "ci": [
      "@lint",
      "@phpcs",
      "@phpstan"
    ],
    "deploy:test": "terminus env:deploy fixme-app-name.test && terminus env:clear-cache fixme-app-name.test",
    "deploy:live": "terminus env:deploy fixme-app-name.live",
    "deploy:all": "terminus env:deploy fixme-app-name.test && terminus env:clear-cache fixme-app-name.test && terminus env:deploy fixme-app-name.live && terminus env:clear-cache fixme-app-name.live",
    "theme:dev": [
      "Composer\\Config::disableProcessTimeout",
      "cd web/wp-content/themes/sage && yarn start"
    ],
    "theme:build": [
      "Composer\\Config::disableProcessTimeout",
      "cd web/wp-content/themes/sage && yarn build"
    ],
    "replace-fixme": "php scripts/composer/ReplaceFixme.php",
    "collect-logs": [
      "./logs/collect-logs-rsync.sh"
    ]
  }
}
