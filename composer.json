{
  "name": "threespot/example-wordpress-composer",
  "description": "Terminus build tools template for a Pantheon Composer WordPress application",
  "type": "project",
  "license": "proprietary",
  "keywords": [],
  "repositories": [
    {
      "type": "composer",
      "url": "https://composer.admincolumns.com"
    },
    {
      "type": "composer",
      "url": "https://composer.gravity.io"
    },
    {
      "type": "composer",
      "url": "https://connect.advancedcustomfields.com"
    },
    {
      "type": "composer",
      "url": "https://gravitywiz.com/composer"
    },
    {
      "type": "composer",
      "url": "https://objectcache.pro/repo/"
    },
    {
      "type": "composer",
      "url": "https://repo.wp-packages.org"
    },
    {
      "type": "vcs",
      "url": "https://github.com/threespot/wp-base-config"
    },
    {
      "type": "vcs",
      "url": "https://github.com/threespot/wp-fixtures"
    },
    {
      "type": "package",
        "package": {
          "name": "junaidbhura/acf-extended-pro",
