<?xml version="1.0"?>
<ruleset name="Project">
    <description>PHPCS ruleset for project-owned WordPress runtime code (mu-plugins,
    custom theme code). Project bootstrap (config/, web/wp-config.php) and build
    scripts (scripts/composer/) deliberately follow PSR-12, not WPCS, and are
    not scanned here. Starts from Pantheon-WP-Minimum so we can ratchet up to
    Pantheon-WP once the baseline is clean.</description>

    <file>web/wp-content/themes/sage/app</file>
    <file>web/wp-content/themes/sage/config</file>
    <file>web/wp-content/themes/sage/functions.php</file>

    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/web/wp/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="Pantheon-WP-Minimum"/>

    <config name="minimum_supported_wp_version" value="6.4"/>
    <config name="testVersion" value="8.3-"/>
</ruleset>
