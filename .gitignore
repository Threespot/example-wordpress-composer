###
### GitHub repository .gitignore section
###

# Ignore directories generated by Composer
/vendor/

# Webroot #
###########
!web/
web/*
!web/index.php
!web/wp-cli.yml
!web/wp-config.php
!web/wp-content/
web/wp-content/*
!web/wp-content/cache
!web/wp-content/mu-plugins/
web/wp-content/mu-plugins/*
!web/wp-content/mu-plugins/custom
!web/wp-content/mu-plugins/.gitkeep
!web/wp-content/plugins/
web/wp-content/plugins/*
!web/wp-content/plugins/custom/
!web/wp-content/plugins/.gitkeep
!web/wp-content/themes
web/wp-content/themes/*
!web/wp-content/themes/.gitkeep
!web/wp-content/config/
web/wp
!web/private/
web/private/*
!web/private/scripts/
web/private/scripts/quicksilver/*
!web/private/scripts/quicksilver/threespot-cloudflare-purge/
!web/private/scripts/quicksilver/threespot-object-cache-flush/
!web/private/config/
!.circleci
.bashrc

# Threespot custom rules
.env
*.env
.env.*
!.env.example
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/php.ini
!.vscode/extensions.json
!.vscode/*.code-snippets
auth.json
.stylelintcache
logs/*
!logs/collect-logs-rsync.sh
# Claude
.claude/
refactor-preview
# Yarn (v2+)
/.yarn/*
!/.yarn/patches
!/.yarn/plugins
!/.yarn/releases
!/.yarn/sdks
!/.yarn/versions
/.pnp.*

# PHPUnit
.phpunit.result.cache

# Visual regression testing
/node_modules/
/visual-regression/playwright-report/
/visual-regression/test-results/
# Overrides to keep files
!web/cache
!web/wp-content/mu-plugins/bedrock-autoloader.php
!web/wp-content/mu-plugins/custom-post-types
!web/wp-content/mu-plugins/custom-taxonomies
!web/wp-content/mu-plugins/disable-polylang-cookie.php
!web/wp-content/mu-plugins/loader.php
!web/wp-content/mu-plugins/suppress-admin-notices.php
!web/wp-content/mu-plugins/threespot-wp-base-config.php
!web/wp-content/object-cache.php
# Include any plugins not loaded via composer
!web/wp-content/plugins/facetwp*
!web/wp-content/plugins/polylang-pro
!web/wp-content/plugins/searchwp*
# The Events Calendar
!web/wp-content/plugins/events-calendar-pro
!web/wp-content/plugins/the-events-calendar-*
# PublishPress plugins
!web/wp-content/plugins/advanced-gutenberg-pro
!web/wp-content/plugins/capabilities-pro
!web/wp-content/plugins/presspermit-pro
!web/wp-content/plugins/publishpress*
!web/wp-content/plugins/revisionary-pro
# Theme
!web/wp-content/themes/sage
!web/wp-content/uploads/cache/acorn/framework/cache/.gitkeep

# Add directories containing build assets below.
# Keep all additions above the "cut" line.



# :::::::::::::::::::::: cut ::::::::::::::::::::::

###
### Pantheon site .gitignore section
###
### Items below the "cut" line are still ignored on
### the Pantheon site. Items above the "cut" line
### are ignored in the GitHub repository, but committed
### to the Pantheon repository.
###

# WordPress #
############
web/wp-config-local.php
web/wp-cli.local.yml
web/wp-content/uploads
web/wp-content/blogs.dir/
web/wp-content/upgrade/
web/wp-content/backup-db/
web/wp-content/updraft/
web/wp-content/backupwordpress-*/
web/wp-content/managewp/backups/
web/wp-content/advanced-cache.php
web/wp-content/wp-cache-config.php
web/sitemap.xml
web/sitemap.xml.gz
*.log

# @TODO writable paths
web/wp-content/cache/
web/wp-content/backups/

# Avoid accidental modification of pantheon.upstream.yml in sites
# created from this upstream
pantheon.upstream.yml

# Packages #
############
*.7z
*.dmg
*.gz
*.bz2
*.iso
*.jar
*.rar
*.tar
*.zip
*.tgz

# Logs and databases #
######################
*.log
*.sql

# OS generated files #
######################
.DS_Store*
ehthumbs.db
# Info on ignoring Icon? files
# https://stackoverflow.com/questions/17556250/how-to-ignore-icon-in-git
Icon[
]
Thumbs.db
._*

# Vim generated files #
######################
*.un~

# SASS #
##########
.sass-cache
