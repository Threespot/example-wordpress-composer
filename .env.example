# This is a sample config for local development.
# Simply edit/copy as needed and rename to .env.local.
# application.php will load this file if you're not in a Pantheon (dev/test/live) environment.

WP_HOME=https://fixme-app-name.lndo.site
WP_SITEURL=${WP_HOME}/wp
WP_ENV=development

DB_NAME=pantheon
DB_USER=pantheon
DB_PASSWORD=pantheon
DB_HOST=database

# Optional database variables
# DB_HOST='localhost'
# DB_PREFIX='wp_'

# Specify optional debug.log path starting from web root.
# WP_DEBUG_LOG='/app/debug.log'

# Generate your keys here: https://roots.io/salts.html
AUTH_KEY=generateme
SECURE_AUTH_KEY=generateme
LOGGED_IN_KEY=generateme
NONCE_KEY=generateme
AUTH_SALT=generateme
SECURE_AUTH_SALT=generateme
LOGGED_IN_SALT=generateme
NONCE_SALT=generateme

# ACF Pro
# https://www.advancedcustomfields.com/resources/installing-acf-pro-with-composer/
ACF_PRO_KEY=FIXME_get_from_1password

# Admin Columns Pro
ACP_LICENCE=FIXME_get_from_1password

# Object Cache Pro
OCP_LICENSE=FIXME_get_from_1password

# SearchWP
SEARCHWP_LICENSE_KEY=FIXME_get_from_1password

# For Vite
APP_URL=${WP_HOME}
