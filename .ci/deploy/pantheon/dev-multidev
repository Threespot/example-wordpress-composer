#!/bin/bash

set -eo pipefail

#
# This script deploys the build artifact to Pantheon.
# On the master branch the dev environment is used.
# Otherwise a multidev environment is used.
#

# Authenticate with Terminus
terminus -n auth:login --machine-token="$TERMINUS_TOKEN"

# Prepare for Pantheon
composer run prepare-for-pantheon

if [[ $CI_BRANCH != $DEFAULT_BRANCH ]]
then
    # Create a new multidev environment (or push to an existing one)
    terminus -n build:env:create "$TERMINUS_SITE.dev" "$TERMINUS_ENV" --yes
else
    # Push to the dev environment
    terminus -n build:env:push "$TERMINUS_SITE.dev" --yes
fi

# The remaining tasks are independent of one another, so run them
# concurrently (their log output will interleave).
pids=()

# Run update-db to ensure that the cloned database is updated for the new
# code, then clear the site environment's cache (must run after update-db).
(
    terminus -n wp $TERMINUS_SITE.$TERMINUS_ENV -- core update-db
    # Not redundant with the sync_code Quicksilver hooks: those purge
    # Cloudflare only. Verified 2026-07-22 — a code sync with this line
    # disabled left the Pantheon edge cache untouched (Age kept growing).
    terminus -n env:clear-cache "$TERMINUS_SITE.$TERMINUS_ENV"
) &
pids+=($!)

# Ensure secrets are set
(
    terminus -n secrets:set "$TERMINUS_SITE.$TERMINUS_ENV" token "$GITHUB_TOKEN" --file='github-secrets.json' --clear --skip-if-empty

    # Object Cache Pro license token — consumed at runtime by config/application.php
    # from ~/files/private/secrets.json. Don't pass --clear so other keys persist.
    terminus -n secrets:set "$TERMINUS_SITE.$TERMINUS_ENV" OCP_LICENSE "$OCP_LICENSE" --file='secrets.json' --skip-if-empty
) &
pids+=($!)

# Delete old multidev environments associated
# with a PR that has been merged or closed.
terminus -n build:env:delete:pr $TERMINUS_SITE --yes &
pids+=($!)

# wait surfaces each task's exit code, so set -e fails the deploy on the
# first task that failed.
for pid in "${pids[@]}"; do
    wait "$pid"
done
