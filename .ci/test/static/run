#!/bin/bash

set -eo pipefail

#
# This script runs static tests which
# can be performed without code execution.
#

# Run composer install to get the vendor directory
# ext-redis is ignored because the CI image doesn't ship it; Object Cache Pro
# requires it, but nothing is executed during static analysis.
composer install --ignore-platform-req=ext-redis --no-ansi --no-interaction --optimize-autoloader --no-progress

# Lint php code for syntax errors. `composer lint` reads the file list from
# `git ls-files` and excludes web/wp-content/plugins, so third-party plugin
# code (committed or composer-installed) is never linted.
composer -n lint

# Install the Sage theme's composer dependencies so PHPStan can resolve
# Acorn / Illuminate types. Skipped if the theme isn't present yet.
if [ -f web/wp-content/themes/sage/composer.json ]; then
    (cd web/wp-content/themes/sage && \
        composer install --ignore-platform-req=ext-redis --no-dev --no-ansi --no-interaction --no-progress --prefer-dist)
fi

# Coding standards (Pantheon-WP-Minimum via pantheon-systems/pantheon-wp-coding-standards).
# phpcs.xml.dist scans loader.php and the Sage theme; skip when Sage isn't present yet.
if [ -d web/wp-content/themes/sage/app ]; then
    composer -n phpcs
else
    echo "Skipping phpcs: web/wp-content/themes/sage/app not present."
fi

# Static analysis (PHPStan + szepeviktor/phpstan-wordpress)
composer -n phpstan
